# Sandbox image for Build mode: every agent command runs inside this container.
#   npm run docker:image
#   BUILD_SANDBOX=docker NEBULA_BUILD=1 npm start
FROM node:20-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv python3-dev build-essential git curl ca-certificates sqlite3 zip unzip \
    poppler-utils libreoffice-core libreoffice-writer libreoffice-impress libreoffice-calc \
    fonts-dejavu fonts-liberation fonts-noto-core libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz0b libffi-dev libjpeg-dev zlib1g-dev \
 && rm -rf /var/lib/apt/lists/*
ENV PIP_BREAK_SYSTEM_PACKAGES=1
RUN pip3 install --no-cache-dir reportlab weasyprint pypdf pymupdf python-pptx python-docx openpyxl xlsxwriter pillow matplotlib pandas numpy
WORKDIR /work
